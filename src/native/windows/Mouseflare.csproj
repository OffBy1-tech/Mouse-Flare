<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mouseflare</AssemblyName>
    <RootNamespace>Mouseflare</RootNamespace>
    <!-- 0.0.0 marks dev builds (never self-update); CI stamps stable tags -->
    <Version>0.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\app-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded for XAML (window icon / title bar brand) -->
    <Resource Include="Assets\app-logo.png" />
    <!-- Loose copy for the WinForms tray icon (System.Drawing reads from disk) -->
    <Content Include="Assets\app-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app-logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>