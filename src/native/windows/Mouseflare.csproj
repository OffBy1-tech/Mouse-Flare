<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mouseflare</AssemblyName>
    <RootNamespace>Mouseflare</RootNamespace>
    <!-- 0.0.0 marks dev builds (never self-update); CI stamps stable tags -->
    <Version>0.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\app-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded WPF resource ONLY (XAML brand image, window icon, and the
         tray icon via Application.GetResourceStream). It must NOT also be a
         Content item: content-file pack URIs resolve through Assembly.Location,
         which is empty under PublishSingleFile — the XAML loader then crashes
         with ArgumentNullException in Path.Combine. -->
    <Resource Include="Assets\app-logo.png" />
  </ItemGroup>

</Project>