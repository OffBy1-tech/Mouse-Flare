<Window x:Class="Mouseflare.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mouseflare.UI"
        Title="Color Picker" Width="340" Height="616"
        WindowStyle="None" Background="#0A0512"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled">

    <!-- Opaque WindowChrome window for guaranteed ClearType; DWM rounds
         the corners on Windows 11 (DwmChrome). See SettingsWindow.xaml. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Element form (not Source=): the dictionary has code-behind
                 for the popup DWM-rounding handler, which Source= ignores. -->
            <ResourceDictionary.MergedDictionaries>
                <ui:NeonControls/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Gradient border at the window edge; square-drawn so DWM's corner
         rounding clips border and content together. -->
    <Border Background="#0A0512" BorderThickness="2">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A855F7" Offset="0"/>
                <GradientStop Color="#4F7CFF" Offset="0.55"/>
                <GradientStop Color="#F043C8" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title, eyedropper, old/new colors -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock x:Name="txtTitle" Text="Custom Color" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnEyedropper" Width="30" Height="30" Background="#1A0F2E" BorderBrush="#4A2E75" Cursor="Hand" ToolTip="Pick a color from the screen" Click="OnEyedropper">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15">
                                    <Path Data="M 17,3 L 21,7 L 19,9 L 20,10 L 18,12 L 12,6 L 14,4 L 15,5 Z M 11,7 L 17,13 L 8,22 L 4,22 L 2,20 L 2,16 Z" Fill="#FAFAFA" Stretch="Uniform" Width="13" Height="13"/>
                                </Border>
                                    <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="15" Opacity="0" IsHitTestVisible="False"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Grid Margin="12,0,0,0" Width="42" Height="26">
                        <Ellipse x:Name="oldColorCircle" Width="26" Height="26" HorizontalAlignment="Left" Stroke="#D9FFFFFF" StrokeThickness="2" Fill="#F59E0B"/>
                        <Ellipse x:Name="newColorCircle" Width="26" Height="26" HorizontalAlignment="Right" Stroke="#D9FFFFFF" StrokeThickness="2" Fill="#F59E0B"/>
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!-- Wheel: hue ring + SV disc + handles -->
            <Canvas x:Name="wheelCanvas" Grid.Row="1" Width="280" Height="280" Background="Transparent" HorizontalAlignment="Center"
                    MouseLeftButtonDown="OnWheelMouseDown" MouseMove="OnWheelMouseMove" MouseLeftButtonUp="OnWheelMouseUp">
                <Image x:Name="imgRing" Width="280" Height="280"/>
                <Image x:Name="imgDisc" Width="280" Height="280"/>
                <Ellipse x:Name="hueHandle" Width="26" Height="26" Stroke="White" StrokeThickness="3" Fill="Red" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.55"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="discHandle" Width="22" Height="22" Stroke="White" StrokeThickness="3" Fill="Red" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.55"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Current color arc preview -->
            <Path x:Name="arcPreview" Grid.Row="2" Stroke="#F59E0B" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 34,14 A 250,250 0 0 0 246,14" Height="44" Width="280" HorizontalAlignment="Center" Margin="0,6,0,2"/>

            <!-- Hex entry -->
            <TextBox x:Name="txtHex" Grid.Row="3" Text="#F59E0B" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                     HorizontalContentAlignment="Center" Padding="0,7" Margin="0,10,0,0" KeyDown="OnHexKeyDown"/>

            <!-- Quick swatches (click to load into the picker) -->
            <TextBlock Grid.Row="4" Text="QUICK SWATCHES" FontSize="10" FontWeight="Bold" Foreground="#7A6F94" Margin="0,14,0,6"/>
            <StackPanel x:Name="pnlSwatches" Grid.Row="5" Orientation="Horizontal"/>

            <!-- Actions -->
            <DockPanel Grid.Row="7" LastChildFill="False" Margin="0,14,0,0">
                <Button Content="Cancel" Width="80" Height="32" FontSize="12" Cursor="Hand" DockPanel.Dock="Left" Click="OnCancel"/>
                <Button Content="Done" Width="96" Height="32" FontSize="12" Cursor="Hand" DockPanel.Dock="Right" Click="OnDone"
                        Style="{StaticResource NeonPrimaryButton}"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
