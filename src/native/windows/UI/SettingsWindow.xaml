                                        <TextBlock Text="Wake-From-Idle Burst" FontWeight="Bold" FontSize="13" Foreground="#FAFAFA"/>
                                        <TextBlock Text="Emits a spark burst when first moving the mouse after &gt;2 seconds of inactivity." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <CheckBox x:Name="chkMonitorCrossing" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnMonitorCrossingChanged" Unchecked="OnMonitorCrossingChanged"/>
                                    <StackPanel>
                                        <TextBlock Text="Monitor-Crossing Transition FX" FontWeight="Bold" FontSize="13" Foreground="#FAFAFA"/>
                                        <TextBlock Text="Fires a subtle pulse when the cursor passes between multiple displays." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================== -->
                    <!-- TAB 4: DIAGNOSTICS & SYSTEM TELEMETRY          -->
                    <!-- ============================================== -->
                    <ScrollViewer x:Name="tabDiagnostics" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Diagnostics &amp; System Telemetry" FontSize="17" FontWeight="Bold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Real-time rendering metrics and display configuration." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,16"/>

                            <Border Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Hardware Engine: Direct2D / WPF Composition Target" FontWeight="Bold" FontSize="12" Foreground="#FAFAFA"/>
                                    <TextBlock Text="Target Framerate: 60 / 120 / 144 Hz (VSync synchronized)" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                    <TextBlock Text="Virtual Desktop Span: Multi-Monitor Ready" FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    <TextBlock Text="Input Interception: Low-level WH_MOUSE_LL Windows Hook (Zero Click Lag)" FontSize="11" Foreground="#FFA62E" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================== -->
                    <!-- TAB 5: SOFTWARE UPDATES                        -->
                    <!-- ============================================== -->
                    <ScrollViewer x:Name="tabUpdates" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Header row: title + primary check button -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                <Button x:Name="btnCheckNow" DockPanel.Dock="Right" Height="32" FontSize="11" Padding="14,0" VerticalAlignment="Top"
                                        Style="{StaticResource NeonPrimaryButton}" Content="🔄 Check for Updates" Click="OnCheckUpdatesNow"/>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Software Updates &amp; Release Feeds" FontSize="17" FontWeight="Bold" Foreground="#FAFAFA"/>
                                    <TextBlock Text="Validate the installed build against verified GitHub Release metadata and install upgrades." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Status hero card (tint follows the updater phase) -->
                            <Border x:Name="cardUpdateHero" Background="#1A0F2E" BorderBrush="#8010B981" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" x:Name="heroIconTile" Width="44" Height="44" CornerRadius="12"
                                            Background="#2210B981" BorderBrush="#5510B981" BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock x:Name="txtHeroIcon" Text="✓" FontSize="20" Foreground="#10B981"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtHeroHeadline" Text="Mouseflare" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA"/>
                                        <TextBlock x:Name="txtHeroTitleLine" Text="" FontSize="11" Foreground="#D4D4D8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtHeroMeta" Text="" FontSize="10" Foreground="#A1A1AA" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" x:Name="pnlHeroActions" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                                        <Button x:Name="btnInstallUpdate" Height="32" FontSize="11" Padding="12,0" Style="{StaticResource NeonPrimaryButton}" Click="OnInstallUpdate"/>
                                        <Button x:Name="btnViewOnGitHub" Height="28" FontSize="10" Margin="0,6,0,0" Content="View on GitHub" Click="OnViewReleaseNotes"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="✦ RELEASE FEED — LIVE FROM GITHUB RELEASES" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,10"/>

                            <!-- Changelog + cadence cards -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="📋 ITEMIZED CHANGELOG" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="pnlChangelog"/>
                                        <Border BorderBrush="#2E1B4A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                                            <TextBlock x:Name="txtChangelogFooter" FontSize="10" Foreground="#A1A1AA"
                                                       Text="Stable channel — GitHub releases/latest  •  minisign-verified installs" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="🎚 UPDATE CADENCE &amp; PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="#4F7CFF" Margin="0,0,0,10"/>

                                        <DockPanel LastChildFill="True">
                                            <CheckBox x:Name="chkAutoUpdates" DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="True" Checked="OnAutoUpdatesChanged" Unchecked="OnAutoUpdatesChanged"/>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Automatic Background Checks" FontWeight="Bold" FontSize="12" Foreground="#FAFAFA"/>
                                                <TextBlock x:Name="txtAutoUpdatesSub" Text="Periodically query the release feed silently." FontSize="10" Foreground="#71717A" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border BorderBrush="#2E1B4A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                    <TextBlock Text="Check Frequency" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                                                    <TextBlock x:Name="txtFrequencyValue" DockPanel.Dock="Right" FontSize="10" Foreground="#A78BFA" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ComboBox x:Name="cmbCheckFrequency" Height="30" FontSize="11" SelectionChanged="OnCheckFrequencyChanged">
                                                    <ComboBoxItem Content="Every 6 Hours (High Frequency)" Tag="6"/>
                                                    <ComboBoxItem Content="Every 24 Hours (Daily)" Tag="24"/>
                                                    <ComboBoxItem Content="Every 72 Hours (Weekly)" Tag="72"/>
                                                    <ComboBoxItem Content="Manual Checks Only" Tag="0"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="#2E1B4A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="🛡 Minimum System Requirements" FontSize="10" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                                                <TextBlock Text="• Windows 10 or later (64-bit)" FontSize="10" Foreground="#A1A1AA" Margin="0,3,0,0"/>
                                                <TextBlock Text="• .NET 8 Desktop Runtime (x64)" FontSize="10" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Security & Package Verification (parity with web/macOS) -->
                            <Border Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="🛡 SECURITY &amp; PACKAGE VERIFICATION" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text="Every release ships SHA-256 checksums, and stable releases are additionally minisign-signed. Verify a download against the project's public key:" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBox x:Name="txtMinisignCommand" Text="minisign -Vm Mouseflare-Windows.zip -P RWQV1L6pDRSw69B18smY6ny2RZpAecKvPvS48ImhiukQjEmN8lAqP3Mw" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#150E26" Foreground="#C9B8FF" BorderBrush="#2E1B4A" BorderThickness="1" Padding="8,6" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Copy Command" FontSize="11" Padding="10,4" Click="OnCopyMinisignCommand"/>
                                        <Button Content="Download SHA256SUMS.txt" FontSize="11" Padding="10,4" Margin="8,0,0,0" Click="OnDownloadChecksums"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================================== -->
                    <!-- FOOTER ACTION BAR                              -->
                    <!-- ============================================== -->
                    <Border Grid.Row="1" BorderBrush="#2E1B4A" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Dedicated Status Message Line (Above Buttons to Prevent Overlap) -->
                            <Border Grid.Row="0" Margin="0,0,0,8" Background="#120A20" BorderBrush="#2E1B4A" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <DockPanel LastChildFill="True">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="txtSaveStatus" Text="Ready. FX changes preview live — click Apply &amp; Save to keep them." FontSize="11" Foreground="#A1A1AA" FontWeight="Medium" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Button Actions Line -->
                            <DockPanel Grid.Row="1" LastChildFill="False">
                                <Button Content="Reset Defaults" Width="96" Height="32" Background="Transparent" BorderBrush="Transparent" Foreground="#A1A1AA" FontSize="11" DockPanel.Dock="Left" Click="OnResetDefaults"/>

                                <Button Content="Close" Width="76" Height="32" FontSize="11" Foreground="#FAFAFA" DockPanel.Dock="Right" Click="OnCloseWindow"/>

                                <Button x:Name="btnSave" Content="Apply &amp; Save" Width="116" Height="32" FontSize="11" Style="{StaticResource NeonPrimaryButton}" DockPanel.Dock="Right" Margin="0,0,8,0" Click="OnSaveAndApply"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>