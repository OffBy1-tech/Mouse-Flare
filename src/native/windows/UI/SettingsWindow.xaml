<Window x:Class="Mouseflare.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mouseflare.UI"
        Title="Mouseflare — Settings &amp; FX Studio" Height="680" Width="940"
        Icon="/Assets/app-logo.png"
        WindowStyle="None" Background="#0A0512"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        PreviewKeyDown="OnHotkeyPreviewKeyDown"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled">

    <!-- Opaque WindowChrome window: layered windows (AllowsTransparency)
         disable ClearType outright, so the chrome went opaque for crisp
         text. DWM supplies rounded corners + drop shadow on Windows 11
         (DwmChrome, hooked on SourceInitialized); the bottom glass sliver
         keeps the standard window shadow alive. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Neon control templates + shared brushes; implicit styles here
                 also reach the code-built FX Designer and Updates controls.
                 Element form (not Source=): the dictionary has code-behind
                 for the popup DWM-rounding handler, which Source= ignores. -->
            <ResourceDictionary.MergedDictionaries>
                <ui:NeonControls/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- MAIN WINDOW CONTAINER: neon gradient border at the window edge.
         Square-drawn (CornerRadius 0) so DWM's Windows 11 corner rounding
         clips border and content together with no notch; Windows 10 shows
         square corners. The old outer glow margin is gone — effects cannot
         extend past an opaque window, so DWM's shadow stands in. -->
    <Border BorderThickness="2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Color="#120A20" Offset="0"/>
                <GradientStop Color="#0A0512" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A855F7" Offset="0"/>
                <GradientStop Color="#4F7CFF" Offset="0.55"/>
                <GradientStop Color="#F043C8" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM MODERN TITLEBAR -->
            <Border Grid.Row="0" Background="#0D0718" BorderBrush="#2E1B4A" BorderThickness="0,0,0,1" CornerRadius="0" MouseDown="OnTitleBarMouseDown">
                <DockPanel LastChildFill="True">
                    <!-- Title Bar Window Controls (Right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="─" Width="44" Height="40" Background="Transparent" Foreground="#A1A1AA" FontSize="11" BorderThickness="0" Cursor="Hand" Click="OnMinimizeWindow">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="btnBrd" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBrd" Property="Background" Value="#2E1B4A"/>
                                            <Setter Property="Foreground" Value="#FAFAFA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Width="44" Height="40" Background="Transparent" Foreground="#A1A1AA" FontSize="11" BorderThickness="0" Cursor="Hand" Click="OnCloseWindow">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="btnCloseBrd" Background="{TemplateBinding Background}" CornerRadius="0,12,0,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnCloseBrd" Property="Background" Value="#DC2626"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Title Bar Brand (Left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/app-logo.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="Mouseflare" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Settings &amp; FX Studio" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN BODY WITH SIDEBAR & CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR NAVIGATION -->
                <Border Grid.Column="0" Background="#0D0718" BorderBrush="#2E1B4A" BorderThickness="0,0,1,0" Padding="12" CornerRadius="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <!-- Bottom Action Button -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock x:Name="txtSidebarVersion" Text="Mouseflare v0.0.0" FontSize="10" Foreground="#FAFAFA" HorizontalAlignment="Center" Margin="0,0,0,6" MouseLeftButtonDown="OnVersionTextClicked"/>
                            <Button x:Name="btnTestFlareSidebar" Height="36" Style="{StaticResource NeonPrimaryButton}" FontSize="11" Click="OnTestFlare">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test Flare Now" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Nav List -->
                        <StackPanel>
                            <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#6E5F8E" Margin="8,4,0,10"/>

                            <Button x:Name="btnNavGeneral" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="Transparent" Foreground="#D4D4D8" BorderThickness="0" Cursor="Hand" Click="OnNavGeneral">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#1A0F2E" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" Stroke="#FBBF24" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="General" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnNavFxStudio" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="#2EA855F7" BorderBrush="#80A855F7" BorderThickness="1" Foreground="#E9D5FF" Cursor="Hand" Click="OnNavFxStudio">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#2E1B4A" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z M20 2v4 M22 4h-4 M2 20a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" Stroke="#22D3EE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="FX Studio" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnNavFxDesigner" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="Transparent" Foreground="#D4D4D8" BorderThickness="0" Cursor="Hand" Click="OnNavFxDesigner">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#1A0F2E" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10 8h4 M12 21v-9 M12 8V3 M17 16h4 M19 12V3 M19 21v-5 M3 14h4 M5 10V3 M5 21v-7" Stroke="#FBBF24" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="FX Designer" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnNavBehavior" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="Transparent" Foreground="#D4D4D8" BorderThickness="0" Cursor="Hand" Click="OnNavBehavior">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#1A0F2E" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M10 8h4 M12 21v-9 M12 8V3 M17 16h4 M19 12V3 M19 21v-5 M3 14h4 M5 10V3 M5 21v-7" Stroke="#34D399" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="Behavior &amp; Monitors" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnNavDiagnostics" Visibility="Collapsed" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="Transparent" Foreground="#D4D4D8" BorderThickness="0" Cursor="Hand" Click="OnNavDiagnostics">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#1A0F2E" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" Stroke="#A78BFA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnNavUpdates" Height="38" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="10,0" Background="Transparent" Foreground="#D4D4D8" BorderThickness="0" Cursor="Hand" Click="OnNavUpdates">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                        <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True"/>
                                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="4" Background="#1A0F2E" Margin="0,0,8,0">
                                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5" Stroke="#FBBF24" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                                                </Border>
                                                <TextBlock Text="Check for Updates" FontWeight="SemiBold" FontSize="12" Foreground="#FAFAFA"/>
                                            </StackPanel>
                                        </Border>
                                            <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- RIGHT MAIN CONTENT PANEL -->
                <Grid Grid.Column="1" Margin="22,18,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ============================================== -->
                    <!-- TAB 2: FX STUDIO (Primary Default View)         -->
                    <!-- ============================================== -->
                    <ScrollViewer x:Name="tabFxStudio" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Section Title -->
                            <TextBlock Text="FX Studio &amp; Particle Customizer" FontSize="17" FontWeight="Bold" Foreground="#FAFAFA"/>
                            <TextBlock Text="Configure movement trails, signature flare shockwaves, color palettes, and physics." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,16"/>

                            <!-- Passive Movement Styles -->
                            <TextBlock Text="Passive Movement FX (Trail Styles)" FontSize="12" FontWeight="Bold" Foreground="#FFA62E" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Tag="fluid-simulation" Width="195" Height="52" Margin="0,0,8,8" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" Cursor="Hand" Click="OnSelectPassivePreset">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                            <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="6" Background="#0C343D" Margin="0,0,8,0">
                                                        <Path Data="M 12,2 A 10,10 0 1 0 22,12 M 12,6 A 6,6 0 1 0 18,12" Stroke="#2FD4F5" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="14" Height="14"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Fluid Simulation" FontWeight="Bold" FontSize="11" Foreground="#FAFAFA"/>
                                                        <TextBlock Text="Velocity dissipation model" FontSize="9" Foreground="#A1A1AA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                                <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>


                                <Button Tag="fluid-smoke" Width="195" Height="52" Margin="0,0,8,8" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" Cursor="Hand" Click="OnSelectPassivePreset">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                            <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="6" Background="#281A3C" Margin="0,0,8,0">
                                                        <Path Data="M 12,3 C 8,3 5,7 7,12 C 5,14 6,18 10,19 C 14,20 18,17 17,13 C 19,9 16,3 12,3 Z" Fill="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="14" Height="14"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Fluid Smoke Swirl" FontWeight="Bold" FontSize="11" Foreground="#FAFAFA"/>
                                                        <TextBlock Text="Billowing dye vortices" FontSize="9" Foreground="#A1A1AA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                                <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Tag="neon-fluid" Width="195" Height="52" Margin="0,0,8,8" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" Cursor="Hand" Click="OnSelectPassivePreset">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                            <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
                                            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="8,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="6" Background="#0C343D" Margin="0,0,8,0">
                                                        <Path Data="M 4,12 C 8,4 16,20 20,12" Stroke="#2FD4F5" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="14" Height="14"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Neon Fluid Dye" FontWeight="Bold" FontSize="11" Foreground="#FAFAFA"/>
                                                        <TextBlock Text="Luminescent fluid glow" FontSize="9" Foreground="#A1A1AA"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                                <Border x:Name="hoverWash" Background="{StaticResource NeonHoverWash}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hoverWash" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Tag="cosmic-vortex" Width="195" Height="52" Margin="0,0,8,8" Background="#1A0F2E" BorderBrush="#2E1B4A" BorderThickness="1" Cursor="Hand" Click="OnSelectPassivePreset">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                            <Border x:Name="glowHost" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"/>
