<ResourceDictionary x:Class="Mouseflare.UI.NeonControls"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =============================================================== -->
    <!-- Neon control templates (mirror UI/NeonTheme.cs + web index.css) -->
    <!-- Implicit styles here reach code-built controls too (FX Designer -->
    <!-- panel, Updates tab) via the window's resource tree.             -->
    <!-- =============================================================== -->

    <!-- Shared brushes -->
    <LinearGradientBrush x:Key="NeonPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA62E" Offset="0"/>
        <GradientStop Color="#FF5E62" Offset="0.55"/>
        <GradientStop Color="#F043C8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonCheckFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F7CFF" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonThumbFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F7CFF" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>
    <!-- Low-intensity "Mars row" fill for dropdown selection -->
    <LinearGradientBrush x:Key="NeonSelectedLowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#664F7CFF" Offset="0"/>
        <GradientStop Color="#66A855F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NeonHoverWash" Color="#2EA855F7"/>

    <!-- Shared glows (modest blur: WPF renders effects on the UI thread) -->
    <DropShadowEffect x:Key="NeonQuietGlow" Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.28"/>
    <DropShadowEffect x:Key="NeonPopupGlow" Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="NeonFocusGlow" Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="NeonCheckGlow" Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
    <DropShadowEffect x:Key="NeonWarmGlow" Color="#FF8C3C" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
    <DropShadowEffect x:Key="NeonWarmGlowHover" Color="#FF8C3C" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>

    <!-- Keyboard focus ring shared by the templated controls -->
    <Style x:Key="NeonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="#A855F7" StrokeThickness="1" StrokeDashArray="1.5 2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== -->
    <!-- ScrollBar: slim 6px rounded thumb (matches the web scrollbar)   -->
    <!-- =============================================================== -->
    <ControlTemplate x:Key="NeonScrollBarVertical" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border x:Name="thumb" MinHeight="24" Background="#4A2E75" CornerRadius="3" Opacity="0.75"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="thumb" Property="Background" Value="#6E4A9E"/>
                                        <Setter TargetName="thumb" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="NeonScrollBarHorizontal" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="false">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border x:Name="thumb" MinWidth="24" Background="#4A2E75" CornerRadius="3" Opacity="0.75"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="thumb" Property="Background" Value="#6E4A9E"/>
                                        <Setter TargetName="thumb" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template" Value="{StaticResource NeonScrollBarVertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="Template" Value="{StaticResource NeonScrollBarHorizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =============================================================== -->
    <!-- Button: quiet dark surface, violet edge, glow on hover.         -->
    <!-- Primary actions use the keyed NeonPrimaryButton style below.    -->
    <!-- =============================================================== -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#2E1B4A"/>
        <Setter Property="BorderBrush" Value="#4A2E75"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- The glow lives on a childless carrier: an Effect
                         rasterizes its whole subtree, so text must never sit
                         inside the element that glows. -->
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="bd" Property="Background" Value="#3A2560"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeonQuietGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action: amber→magenta gradient with warm glow -->
    <Style x:Key="NeonPrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource NeonPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#80FFC88C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#22080F"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid RenderTransformOrigin="0.5,0.5" x:Name="root">
                        <!-- glowBd carries the always-on warm glow; keeping the
                             text outside the Effect subtree keeps it crisp -->
                        <Border x:Name="glowBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Effect="{StaticResource NeonWarmGlow}"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="sheen" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="sheen" Property="Opacity" Value="0.12"/>
                            <Setter TargetName="glowBd" Property="Effect" Value="{StaticResource NeonWarmGlowHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== -->
    <!-- TextBox: dark rounded field, violet focus glow                  -->
    <!-- =============================================================== -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#0A0512"/>
        <Setter Property="BorderBrush" Value="#4A2E75"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#E5E0F2"/>
        <Setter Property="CaretBrush" Value="#A855F7"/>
        <Setter Property="SelectionBrush" Value="#A855F7"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!-- Focus glow lives on the childless bd so the text is
                         never inside the rasterized Effect subtree -->
                    <Grid>
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True"/>
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#6E4A9E"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeonFocusGlow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== -->
    <!-- CheckBox: rounded box, gradient check state with soft glow      -->
    <!-- =============================================================== -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="#FAFAFA"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="chkBox" Width="20" Height="20" CornerRadius="5" Background="#1A0F2E" BorderBrush="#4A2E75" BorderThickness="1.5" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="chkCheck"
                                  Data="M 4 10 L 8 14 L 15 5"
                                  Stroke="#FFFFFF" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="None" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chkBox" Property="Background" Value="{StaticResource NeonCheckFill}"/>
                            <Setter TargetName="chkBox" Property="BorderBrush" Value="#BEA0FF"/>
                            <Setter TargetName="chkBox" Property="Effect" Value="{StaticResource NeonCheckGlow}"/>
                            <Setter TargetName="chkCheck" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chkBox" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="chkBox" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== -->
    <!-- Slider: thin track with gradient-filled progress, glow thumb    -->
    <!-- =============================================================== -->
    <Style x:Key="NeonSliderRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="NeonSliderThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5" x:Name="root">
            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource NeonThumbFill}" Stroke="#BEA0FF" StrokeThickness="1.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="NeonSliderTemplate" TargetType="{x:Type Slider}">
        <Grid VerticalAlignment="Center" Background="Transparent">
            <Border Height="4" Background="#2E1B4A" CornerRadius="2"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NeonSliderRepeatButton}" Background="{StaticResource NeonThumbFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource NeonSliderRepeatButton}" Background="Transparent" Command="{x:Static Slider.IncreaseLarge}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource NeonSliderThumbTemplate}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource NeonSliderTemplate}"/>
    </Style>

    <!-- Cyan variant for the Fluid Dynamics section (matches web) -->
    <ControlTemplate x:Key="NeonCyanSliderThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5" x:Name="root">
            <Ellipse Width="14" Height="14" Fill="#2FD4F5" Stroke="#96E6FF" StrokeThickness="1.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#2FD4F5" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="NeonCyanSlider" TargetType="{x:Type Slider}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" Background="#1B3350" CornerRadius="2"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource NeonSliderRepeatButton}" Background="#2FD4F5" Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource NeonSliderRepeatButton}" Background="Transparent" Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource NeonCyanSliderThumbTemplate}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== -->
    <!-- ComboBox: the centerpiece — dark rounded field, neon dropdown   -->
    <!-- =============================================================== -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="#D4D4D8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bd" CornerRadius="6" Margin="3,1" Padding="9,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonHoverWash}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonSelectedLowBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#80BEA0FF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="#E5E0F2"/>
        <Setter Property="Background" Value="#0A0512"/>
        <Setter Property="BorderBrush" Value="#4A2E75"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NeonFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="fieldBd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="chevron"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="#A855F7" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fieldBd" Property="BorderBrush" Value="#A855F7"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="fieldBd" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="fieldBd" Property="Effect" Value="{StaticResource NeonFocusGlow}"/>
                                            <Setter TargetName="chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="selectedContent"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,26,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               VerticalOffset="4"
                               AllowsTransparency="False"
                               PopupAnimation="None"
                               Opened="NeonPopup_Opened"
                               Focusable="False">
                            <!-- Opaque popup window: ClearType is guaranteed
                                 for the list text. DWM rounds its corners on
                                 Windows 11 (NeonPopup_Opened); the outer glow
                                 had to go — effects cannot extend past an
                                 opaque popup. Explicit Display mode because
                                 TextOptions doesn't reliably inherit across
                                 the popup boundary. -->
                            <Border Background="#120A20"
                                    BorderBrush="#8CA855F7"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    TextOptions.TextFormattingMode="Display"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
